{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ayran.dev/v1/graph-checkpoint.schema.json",
  "title": "GraphCheckpoint",
  "description": "Verified graph resume marker; absent later-milestone values are represented as null, never fabricated.",
  "x-ayran-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "created_at",
    "stream",
    "journal_cursor",
    "journal_event_hash",
    "journal_commit_hash",
    "projection_schema_version",
    "migration_version",
    "target_hash",
    "config_hash",
    "source_hash",
    "tool_hash",
    "artifact_manifest_hash",
    "outbox_digest",
    "projection_digest",
    "integrity"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "checkpoint_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "stream": { "$ref": "common.schema.json#/$defs/GraphStreamIdentity" },
    "journal_cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "journal_event_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "journal_commit_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "projection_schema_version": { "$ref": "common.schema.json#/$defs/SemVer" },
    "migration_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "target_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "config_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "source_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "tool_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "artifact_manifest_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "outbox_digest": { "$ref": "common.schema.json#/$defs/Hash" },
    "projection_digest": { "$ref": "common.schema.json#/$defs/Hash" },
    "integrity": { "$ref": "integrity.schema.json" }
  }
}
