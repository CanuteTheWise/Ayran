{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ayran.dev/v1/graph-integrity-report.schema.json",
  "title": "GraphIntegrityReport",
  "description": "Typed graph verification, replay, recovery, or doctor result without machine-specific paths.",
  "x-ayran-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "created_at",
    "operation",
    "stream",
    "status",
    "journal_cursor",
    "projection_cursor",
    "last_event_hash",
    "last_commit_hash",
    "verified_segments",
    "verified_batches",
    "verified_events",
    "issues",
    "recovered_suffix_hash",
    "query_digest",
    "integrity"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "report_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "operation": {
      "type": "string",
      "enum": ["verify", "replay", "rebuild", "doctor"]
    },
    "stream": { "$ref": "common.schema.json#/$defs/GraphStreamIdentity" },
    "status": {
      "type": "string",
      "enum": ["ok", "recovered", "corrupt", "incompatible"]
    },
    "journal_cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projection_cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "last_event_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "last_commit_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "verified_segments": { "type": "integer", "minimum": 0 },
    "verified_batches": { "type": "integer", "minimum": 0 },
    "verified_events": { "type": "integer", "minimum": 0 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "segment", "line", "retryable"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "segment": {
            "type": ["string", "null"],
            "pattern": "^[0-9]{6}\\.jsonl$"
          },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "retryable": { "type": "boolean" }
        }
      },
      "maxItems": 10000
    },
    "recovered_suffix_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "query_digest": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "integrity": { "$ref": "integrity.schema.json" }
  }
}
