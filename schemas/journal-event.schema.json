{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ayran.dev/v1/journal-event.schema.json",
  "title": "JournalEvent",
  "description": "Self-contained namespace-aware journal event. The embedded body makes projection rebuild independent of transient caller state.",
  "x-ayran-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journal_format_version",
    "event_id",
    "seq",
    "stream",
    "batch_id",
    "ordinal",
    "aggregate_id",
    "aggregate_version",
    "event_type",
    "actor",
    "operation_id",
    "causation_id",
    "created_at",
    "provenance",
    "integrity",
    "config_hash",
    "source_version",
    "idempotency_key",
    "body",
    "previous_event_hash",
    "event_hash"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "journal_format_version": { "type": "integer", "const": 1 },
    "event_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "stream": { "$ref": "common.schema.json#/$defs/GraphStreamIdentity" },
    "batch_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "ordinal": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "aggregate_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "event_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "actor": { "$ref": "actor.schema.json" },
    "operation_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "causation_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Identifier" },
        { "type": "null" }
      ]
    },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "provenance": {
      "type": "array",
      "items": { "$ref": "provenance.schema.json" },
      "minItems": 1,
      "maxItems": 64
    },
    "integrity": { "$ref": "integrity.schema.json" },
    "config_hash": { "$ref": "common.schema.json#/$defs/Hash" },
    "source_version": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "object_id",
        "content_hash",
        "value",
        "transition"
      ],
      "properties": {
        "contract_id": {
          "$ref": "common.schema.json#/$defs/VersionedContractId"
        },
        "object_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "content_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "value": { "type": "object" },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason", "supersedes"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["snapshot", "retraction", "tombstone"]
            },
            "reason": { "type": ["string", "null"], "maxLength": 2048 },
            "supersedes": { "$ref": "common.schema.json#/$defs/ReferenceList" }
          }
        }
      }
    },
    "previous_event_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "event_hash": { "$ref": "common.schema.json#/$defs/Hash" }
  }
}
