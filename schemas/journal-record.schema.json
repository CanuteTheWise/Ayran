{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ayran.dev/v1/journal-record.schema.json",
  "title": "JournalRecord",
  "description": "A line in the frozen Ayran JSONL journal v1 begin/event/commit grammar.",
  "x-ayran-schema-version": "1.0.0",
  "$defs": {
    "ExpectedRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_id", "revision"],
      "properties": {
        "aggregate_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "BatchBegin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "journal_format_version",
        "hash_domain",
        "record_type",
        "stream",
        "batch_id",
        "operation_id",
        "causation_id",
        "idempotency_key",
        "request_hash",
        "expected_revisions",
        "first_seq",
        "event_count",
        "previous_event_hash",
        "previous_commit_hash",
        "created_at"
      ],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "journal_format_version": { "type": "integer", "const": 1 },
        "hash_domain": { "const": "ayran.journal.begin.v1" },
        "record_type": { "const": "batch.begin" },
        "stream": { "$ref": "common.schema.json#/$defs/GraphStreamIdentity" },
        "batch_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "operation_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "causation_id": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Identifier" },
            { "type": "null" }
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "request_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "expected_revisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ExpectedRevision" },
          "maxItems": 10000
        },
        "first_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "previous_event_hash": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Hash" },
            { "type": "null" }
          ]
        },
        "previous_commit_hash": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Hash" },
            { "type": "null" }
          ]
        },
        "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
      }
    },
    "BatchEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "journal_format_version",
        "record_type",
        "event"
      ],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "journal_format_version": { "type": "integer", "const": 1 },
        "record_type": { "const": "batch.event" },
        "event": { "$ref": "journal-event.schema.json" }
      }
    },
    "BatchCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "journal_format_version",
        "hash_domain",
        "record_type",
        "stream",
        "batch_id",
        "event_count",
        "first_seq",
        "last_seq",
        "first_event_hash",
        "last_event_hash",
        "begin_hash",
        "members_hash",
        "previous_commit_hash",
        "committed_at",
        "commit_hash"
      ],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
        "journal_format_version": { "type": "integer", "const": 1 },
        "hash_domain": { "const": "ayran.journal.commit.v1" },
        "record_type": { "const": "batch.commit" },
        "stream": { "$ref": "common.schema.json#/$defs/GraphStreamIdentity" },
        "batch_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "event_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "first_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "last_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "first_event_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "last_event_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "begin_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "members_hash": { "$ref": "common.schema.json#/$defs/Hash" },
        "previous_commit_hash": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/Hash" },
            { "type": "null" }
          ]
        },
        "committed_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "commit_hash": { "$ref": "common.schema.json#/$defs/Hash" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/BatchBegin" },
    { "$ref": "#/$defs/BatchEvent" },
    { "$ref": "#/$defs/BatchCommit" }
  ]
}
