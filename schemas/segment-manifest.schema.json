{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ayran.dev/v1/segment-manifest.schema.json",
  "title": "SegmentManifest",
  "description": "Immutable integrity manifest for a closed journal v1 segment.",
  "x-ayran-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journal_format_version",
    "segment_id",
    "segment_name",
    "stream",
    "first_seq",
    "last_seq",
    "first_event_hash",
    "last_event_hash",
    "first_commit_hash",
    "last_commit_hash",
    "previous_manifest_hash",
    "event_count",
    "batch_count",
    "byte_size",
    "file_hash",
    "merkle_root",
    "backup_state",
    "created_at",
    "closed_at",
    "integrity"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "journal_format_version": { "type": "integer", "const": 1 },
    "segment_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "segment_name": { "type": "string", "pattern": "^[0-9]{6}\\.jsonl$" },
    "stream": { "$ref": "common.schema.json#/$defs/GraphStreamIdentity" },
    "first_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "last_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "first_event_hash": { "$ref": "common.schema.json#/$defs/Hash" },
    "last_event_hash": { "$ref": "common.schema.json#/$defs/Hash" },
    "first_commit_hash": { "$ref": "common.schema.json#/$defs/Hash" },
    "last_commit_hash": { "$ref": "common.schema.json#/$defs/Hash" },
    "previous_manifest_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "event_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "batch_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "byte_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "file_hash": { "$ref": "common.schema.json#/$defs/Hash" },
    "merkle_root": { "$ref": "common.schema.json#/$defs/Hash" },
    "backup_state": { "type": "string", "enum": ["pending", "verified"] },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "closed_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "integrity": { "$ref": "integrity.schema.json" }
  }
}
