{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ayran.dev/v1/graph-acknowledgement.schema.json",
  "title": "GraphAcknowledgement",
  "description": "Durable receipt returned only after journal fsync and SQLite commit.",
  "x-ayran-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journal_format_version",
    "stream",
    "batch_id",
    "operation_id",
    "idempotency_key",
    "request_hash",
    "first_seq",
    "last_seq",
    "event_ids",
    "event_hashes",
    "commit_hash",
    "projection_cursor",
    "projection_event_hash",
    "idempotent_replay"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "journal_format_version": { "type": "integer", "const": 1 },
    "stream": { "$ref": "common.schema.json#/$defs/GraphStreamIdentity" },
    "batch_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "operation_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "request_hash": { "$ref": "common.schema.json#/$defs/Hash" },
    "first_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "last_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "event_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Identifier" },
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "event_hashes": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Hash" },
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "commit_hash": { "$ref": "common.schema.json#/$defs/Hash" },
    "projection_cursor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "projection_event_hash": { "$ref": "common.schema.json#/$defs/Hash" },
    "idempotent_replay": { "type": "boolean" }
  }
}
