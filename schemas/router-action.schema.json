{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ayran.dev/v1/router-action.schema.json",
  "title": "RouterAction",
  "description": "Deterministic routed action with trigger, deduplication, handler, authorization, budget, dependencies, and operation/result linkage.",
  "x-ayran-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "router_action_id",
    "created_at",
    "run_id",
    "target_identity",
    "triggering_event_ids",
    "policy_version",
    "deduplication_key",
    "handler",
    "priority",
    "budget_effect",
    "dependencies",
    "authorization",
    "status",
    "context_pack_id",
    "owner",
    "deadline",
    "stop_condition",
    "emitted_operation_ids",
    "result_ids",
    "provenance",
    "integrity"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "router_action_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "run_id": { "$ref": "common.schema.json#/$defs/RunId" },
    "target_identity": { "$ref": "common.schema.json#/$defs/TargetIdentity" },
    "triggering_event_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Identifier" },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "policy_version": { "$ref": "common.schema.json#/$defs/SemVer" },
    "deduplication_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["model", "specialist", "adapter", "service"]
        },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "version": { "$ref": "common.schema.json#/$defs/SemVer" }
      }
    },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "budget_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_units", "tool_seconds", "wall_minutes"],
      "properties": {
        "token_units": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "tool_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "wall_minutes": { "type": "integer", "minimum": 0, "maximum": 1440 }
      }
    },
    "dependencies": { "$ref": "common.schema.json#/$defs/ReferenceList" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "scope_manifest_id",
        "rule_ids",
        "decided_by",
        "decided_at",
        "reason"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["allow", "deny", "requires_human_approval"]
        },
        "scope_manifest_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "rule_ids": { "$ref": "common.schema.json#/$defs/ReferenceList" },
        "decided_by": { "$ref": "actor.schema.json" },
        "decided_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "eligible",
        "queued",
        "running",
        "succeeded",
        "failed",
        "denied",
        "cancelled"
      ]
    },
    "context_pack_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Identifier" },
        { "type": "null" }
      ]
    },
    "owner": { "$ref": "actor.schema.json" },
    "deadline": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "stop_condition": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "emitted_operation_ids": {
      "$ref": "common.schema.json#/$defs/ReferenceList"
    },
    "result_ids": { "$ref": "common.schema.json#/$defs/ReferenceList" },
    "provenance": {
      "type": "array",
      "items": { "$ref": "provenance.schema.json" },
      "minItems": 1,
      "maxItems": 64
    },
    "integrity": { "$ref": "integrity.schema.json" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "succeeded" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "emitted_operation_ids": { "type": "array", "minItems": 1 },
          "result_ids": { "type": "array", "minItems": 1 },
          "authorization": {
            "type": "object",
            "properties": { "decision": { "const": "allow" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "denied" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "authorization": {
            "type": "object",
            "properties": {
              "decision": { "enum": ["deny", "requires_human_approval"] }
            }
          }
        }
      }
    }
  ]
}
