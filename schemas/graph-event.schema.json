{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ayran.dev/v1/graph-event.schema.json",
  "title": "GraphEvent",
  "description": "Immutable idempotent hash-chained graph event. Sequence continuity and hash correctness are contract-set invariants.",
  "x-ayran-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "seq",
    "graph",
    "aggregate_id",
    "aggregate_version",
    "event_type",
    "actor",
    "operation_id",
    "run_id",
    "target_identity",
    "created_at",
    "provenance",
    "integrity",
    "config_hash",
    "source_version",
    "idempotency_key",
    "payload",
    "previous_event_hash",
    "event_hash"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "event_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "graph": { "$ref": "common.schema.json#/$defs/GraphNamespace" },
    "aggregate_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "event_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "actor": { "$ref": "actor.schema.json" },
    "operation_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "run_id": { "$ref": "common.schema.json#/$defs/RunId" },
    "target_identity": { "$ref": "common.schema.json#/$defs/TargetIdentity" },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "provenance": {
      "type": "array",
      "items": { "$ref": "provenance.schema.json" },
      "minItems": 1,
      "maxItems": 64
    },
    "integrity": { "$ref": "integrity.schema.json" },
    "config_hash": { "$ref": "common.schema.json#/$defs/Hash" },
    "source_version": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "object_id", "content_hash"],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*@1\\.0\\.0$"
        },
        "object_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "content_hash": { "$ref": "common.schema.json#/$defs/Hash" }
      }
    },
    "previous_event_hash": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/Hash" },
        { "type": "null" }
      ]
    },
    "event_hash": { "$ref": "common.schema.json#/$defs/Hash" }
  }
}
